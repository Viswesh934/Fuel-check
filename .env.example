# ==============================================================================
# Fuel-Check / Travel-Awareness Co-Pilot Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Routing & Geocoding Services
# ------------------------------------------------------------------------------
# Replaced deprecated/offline OpenRouteService (ORS) with OSRM & Nominatim by default.
# Both work 100% free with NO API KEY required.
ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=nominatim

# Optional commercial API keys (if you prefer Mapbox, Geoapify, or ORS):
MAPBOX_ACCESS_TOKEN=
GEOAPIFY_API_KEY=
ORS_API_KEY=

# ------------------------------------------------------------------------------
# 2. Fuel Station Sourcing (Non-Hardcoded SQL)
# ------------------------------------------------------------------------------
# Decoupled from hardcoded SQLite DB.
# FUEL_STATION_PROVIDER:
#   - 'corridor' (Default: dynamically discovers & positions real truck stop brands
#                 e.g. Love's, Pilot, TA with regional pricing along any route)
#   - 'database' (reads from local Django models / SQLite if populated)
#   - 'live'     (fetches from live fuel pricing API if FUEL_API_KEY is configured)
FUEL_STATION_PROVIDER=corridor

# Optional live fuel API key (e.g., CollectAPI / RapidAPI / GasBuddy):
FUEL_API_KEY=

# ------------------------------------------------------------------------------
# 3. Travel Events & Awareness
# ------------------------------------------------------------------------------
# TRAVEL_EVENTS_SOURCE:
#   - 'both'      (includes simulated test hazards + live weather alerts)
#   - 'simulated' (demo events only, clearly tagged as SIMULATED)
#   - 'live'      (live verified incidents only)
TRAVEL_EVENTS_SOURCE=both

# ------------------------------------------------------------------------------
# 4. AWS Bedrock (Conditional AI / Amazon Nova Micro)
# ------------------------------------------------------------------------------
# Principle: No matching condition on route = NO LLM call (zero cost).
# AI is invoked only when events affect the traveler's route or for conversational questions.
# If keys are not set, a deterministic rule-based travel advisory is safely used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ------------------------------------------------------------------------------
# 5. Bolna Voice Agent Configuration
# ------------------------------------------------------------------------------
# Bolna connects to Fuel-Check's backend endpoints to deliver audio co-pilot voice guidance.
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# ------------------------------------------------------------------------------
# 6. Django Core & Cache
# ------------------------------------------------------------------------------
ROUTE_CACHE_TTL=300
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-vz!lia-+r-24$+s_v8h-(i@#9+b*mw_@#ek=#c+m3vkuhjzm%t
